#!/bin/sh
# Portal Captivo 3000 — CGI de Redirecionamento (BE220 Port)
# /www/cgi-bin/portal_redirect
# Verifica autenticação via chain iptables em vez de nft set

export PATH=/sbin:/bin:/usr/sbin:/usr/bin:$PATH

PORTAL_HOST="roteador.conexaopovosdafloresta.org.br"

if [ -x /sbin/uci ]; then
	_dom=$(/sbin/uci -q get captiveportal.global.router_domain)
	[ -n "$_dom" ] && PORTAL_HOST="$_dom"
fi

PORTAL_URL="https://${PORTAL_HOST}/captive/"

ORIGINAL_HOST="${HTTP_HOST:-}"
ORIGINAL_URI="${REQUEST_URI:-/}"
CLIENT_IP="$REMOTE_ADDR"

IS_AUTHENTICATED=false
if [ -n "$CLIENT_IP" ] && iptables -L CAPTIVE_AUTH_FWD -n >/dev/null 2>&1; then
	if iptables -L CAPTIVE_AUTH_FWD -n 2>/dev/null | grep -q "ACCEPT.*${CLIENT_IP}"; then
		IS_AUTHENTICATED=true
	fi
fi

# Verifica blacklist DNS
IS_BLACKLISTED=false
if [ -n "$ORIGINAL_HOST" ] && [ -f /tmp/dnsmasq.d/captive-blacklist.conf ]; then
	if grep -q "address=/${ORIGINAL_HOST}/" /tmp/dnsmasq.d/captive-blacklist.conf 2>/dev/null; then
		IS_BLACKLISTED=true
	fi
fi

if [ "$IS_BLACKLISTED" = "true" ]; then
	REDIRECT_URL="https://${PORTAL_HOST}/captive/blocked.html"
elif [ "$IS_AUTHENTICATED" = "true" ]; then
	REDIRECT_URL="${PORTAL_URL}"
elif [ -n "$ORIGINAL_HOST" ] && [ "$ORIGINAL_HOST" != "$PORTAL_HOST" ] && [ "$ORIGINAL_HOST" != "192.168.0.1" ]; then
	ORIGINAL_URL="http://${ORIGINAL_HOST}${ORIGINAL_URI}"
	ENCODED_NEXT=$(printf '%s' "$ORIGINAL_URL" | \
		sed 's/%/%25/g; s/ /%20/g; s/:/%3A/g; s|/|%2F|g; s/?/%3F/g; s/=/%3D/g; s/&/%26/g')
	REDIRECT_URL="${PORTAL_URL}?next=${ENCODED_NEXT}"
else
	REDIRECT_URL="${PORTAL_URL}"
fi

printf 'Status: 302 Found\r\n'
printf 'Location: %s\r\n' "$REDIRECT_URL"
printf 'Cache-Control: no-store, no-cache\r\n'
printf 'Content-Type: text/html\r\n'
printf 'Connection: close\r\n'
printf '\r\n'
printf '<html><head><meta http-equiv="refresh" content="0;url=%s"></head>' "$REDIRECT_URL"
printf '<body>Redirecionando para o portal... <a href="%s">Clique aqui</a></body></html>\n' "$REDIRECT_URL"

#!/bin/sh
# Portal Captivo 3000 — Captive Portal API (RFC 8908)
# /www/cgi-bin/captive_portal_api
#
# Implementa o protocolo CAPPORT (RFC 8908 + RFC 8910).
# iOS, Android, Windows e macOS consultam este endpoint automaticamente
# após receber o IP via DHCP (opção 114) para decidir se devem mostrar
# o pop-up "Sign in to Network" ao usuário.
#
# Resposta quando não autenticado:
#   {"captive": true, "user-portal-url": "http://roteador.../portal/"}
#
# Resposta quando autenticado:
#   {"captive": false, "seconds-remaining": 3542}

# ---------------------------------------------------------------------------
# Lê configuração UCI
# ---------------------------------------------------------------------------
ROUTER_DOMAIN=$(uci -q get captiveportal.global.router_domain 2>/dev/null \
    || echo "roteador.conexaopovosdafloresta.org.br")
ROUTER_IP=$(uci -q get captiveportal.global.router_ip 2>/dev/null \
    || echo "192.168.1.1")
SESSIONS_FILE="/tmp/captiveportal_sessions.json"

# URL do portal de login exposta ao cliente
PORTAL_URL="http://${ROUTER_DOMAIN}/portal/"

# ---------------------------------------------------------------------------
# IP do cliente (impossível falsificar — vem do TCP)
# ---------------------------------------------------------------------------
CLIENT_IP="$REMOTE_ADDR"

# ---------------------------------------------------------------------------
# Cabeçalhos RFC 8908
# ---------------------------------------------------------------------------
printf 'Content-Type: application/captive+json\r\n'
printf 'Cache-Control: no-store\r\n'
printf 'Access-Control-Allow-Origin: *\r\n'

# Responde preflight CORS
if [ "$REQUEST_METHOD" = "OPTIONS" ]; then
    printf 'Status: 204 No Content\r\n\r\n'
    exit 0
fi

printf '\r\n'

# ---------------------------------------------------------------------------
# Verifica se o cliente está no set de autenticados do nftables
# ---------------------------------------------------------------------------
IS_AUTH=false
SECONDS_REMAINING=0

if [ -n "$CLIENT_IP" ]; then
    # Consulta o nft set diretamente
    if nft list set inet fw4 captive_authenticated 2>/dev/null | grep -q "$CLIENT_IP"; then
        IS_AUTH=true

        # Tenta buscar o tempo restante no arquivo de sessões
        if [ -f "$SESSIONS_FILE" ]; then
            NOW=$(date +%s)
            EXPIRES=$(awk -v ip="$CLIENT_IP" '
                /"sessions"/ { in_sess=1 }
                in_sess && /"ip"/ && $0 ~ ip { found=1 }
                found && /"expires"/ {
                    match($0, /[0-9]+/)
                    print substr($0, RSTART, RLENGTH)
                    exit
                }
            ' "$SESSIONS_FILE" 2>/dev/null)
            if [ -n "$EXPIRES" ] && [ "$EXPIRES" -gt "$NOW" ]; then
                SECONDS_REMAINING=$(( EXPIRES - NOW ))
            fi
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Retorna JSON RFC 8908
# ---------------------------------------------------------------------------
if $IS_AUTH; then
    # Cliente autenticado — acesso liberado
    printf '{"captive":false,"seconds-remaining":%d}\n' "$SECONDS_REMAINING"
else
    # Cliente não autenticado — informa o URL do portal
    printf '{"captive":true,"user-portal-url":"%s"}\n' "$PORTAL_URL"
fi
